#!/bin/bash
# vfdev: VegaFlow development tools for the test laptop, from the Mac.
# Jobs run in the WinBridge runner (vegaflow package); sync, build-test and deploy use SSH.
#
# Usage:
#   vfdev run JOB [Key=value ...]   launches a job and waits for its result (winbridge jobs run)
#   vfdev submit|wait|status|cancel|busy|list ...   passed as-is to `winbridge jobs`
#   vfdev deploy                      installs the vegaflow package, the tasks and the compiled daemon (administrator over SSH, no UAC)
#   vfdev sync                        brings the current branch's commits to the repository on the laptop (bundle + fast-forward)
#   vfdev build-test                  builds and runs the tests on the laptop; exits with an error if any fails
#   vfdev cross-test                  builds on the Mac (scripts/build/build-cross.sh), sends only the .exe files and their data to the laptop and just runs the tests there
#   vfdev package-test [ZIP]          stages the zip (built with scripts/build/package.sh if none is given) and this branch's tests/package/package_tests.ps1 on the laptop, runs them there and fetches the dated output
#   vfdev first-start [EXE]           first unattended start with no journal (MODE=hidden|task = the installer's autostart task|wt = Windows Terminal, ARG=none|once|dry-run, STDIN=console|file|pipe, JOURNAL=none|unclean|corrupt, ANSWER=n types "n"+Enter in the task's visible console): must reach Global\VegaFlowStop (or exit by itself for --once/--dry-run) in bounded time
#   vfdev octo Conditions=full,... Prefix=x [Captures=1 Seconds=120 Warmup=1 Leave=0]   opens Octopath through Steam, loads the autosave, checks it and measures one block per launch; fetches the screenshots to build/octo
#   vfdev stats FILE|- [PREFIX]      groups result rows by condition: n, mean, median and range
#   vfdev fetch PREFIX [DEST]         fetches from the laptop the JSON and frame CSVs of captures whose label starts with PREFIX
#   vfdev frames GLOB_A GLOB_B        compares two conditions using the frame CSVs: grouped frames and confidence interval
#   vfdev regress BASE.json GLOB      regression gate: compares new captures with a scene's baseline (baselines/); --make creates it
# Variables: VFJOB_HOST (user@ip), VFJOB_KEY (SSH key), VFJOB_RUNNER_SHA256 (deploy: sha256 of runner.ps1 from the WinBridge source repo), WINBRIDGE_BIN (winbridge client, `winbridge` by default),
#   VFJOB_REPO (repository on the laptop), VFJOB_MINGW (g++ bin folder), VFJOB_BASE (bundle base branch, main),
#   VFJOB_QUEUE=1 (build-test even if jobs are running), VFJOB_PKG_ZIP (package-test: zip to use, skips package.sh),
#   VFJOB_PKG_OUT (package-test: folder for the output, build/package-test by default)
set -u

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
HERE="$REPO/scripts/remote"
# Machine-specific settings (user, address, key, paths) come from the environment or from scripts/remote/.env,
# which is not versioned: copy .env.example to .env and fill it in.
if [ -f "$HERE/.env" ]; then set -a; . "$HERE/.env"; set +a; fi
: "${VFJOB_HOST:?set VFJOB_HOST (user@address of the test laptop); see scripts/remote/.env.example}"
: "${VFJOB_KEY:?set VFJOB_KEY (SSH private key); see scripts/remote/.env.example}"
: "${VFJOB_REPO:?set VFJOB_REPO (the repository on the laptop); see scripts/remote/.env.example}"
: "${VFJOB_MINGW:?set VFJOB_MINGW (g++ bin folder on the laptop); see scripts/remote/.env.example}"
HOST="$VFJOB_HOST"
KEY="$VFJOB_KEY"
LAPTOP_REPO="$VFJOB_REPO"
MINGW="$VFJOB_MINGW"
WB="${WINBRIDGE_BIN:-winbridge}"

# Runs a command on the laptop over SSH without interaction.
remote() { ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"; }
# Copies files to the laptop with scp without interaction.
copy_to() { scp -q -i "$KEY" -o BatchMode=yes "$@"; }

# Refuses to run while a job is running or queued on the laptop (VFJOB_QUEUE=1 skips the check).
require_idle() {
    [ "${VFJOB_QUEUE:-0}" = 1 ] && return 0
    local busy
    busy="$("$WB" jobs busy 2>&1)"
    case "$busy" in
    *"no job is queued or running"*) ;;
    *) echo "hay trabajos en curso o en cola ($busy); espera o usa VFJOB_QUEUE=1"; exit 3 ;;
    esac
}

case "${1:-}" in
run | submit | wait | status | cancel | busy | list)
    exec "$WB" jobs "$@"
    ;;
stats)
    shift
    exec python3 -I "$HERE/vfstats.py" "$@"
    ;;
fetch)
    [ -n "${2:-}" ] || { sed -n '2,21p' "$0"; exit 1; }
    mkdir -p "${3:-.}"
    exec scp -q -i "$KEY" -o BatchMode=yes "$HOST:C:/ProgramData/WinBridgeJobs/bench/results/${2}*" "${3:-.}/"
    ;;
frames)
    shift
    exec python3 -I "$HERE/vfframes.py" "$@"
    ;;
regress)
    shift
    exec python3 -I "$HERE/vfregress.py" "$@"
    ;;
deploy)
    remote 'if not exist C:\dev\vf-pkg\scripts mkdir C:\dev\vf-pkg\scripts' || exit 1
    copy_to "$HERE/winbridge-package/manifest.json" "$HERE/busy.html" "$REPO/scripts/tweaks_state.ps1" "$REPO/scripts/ab_profile.ps1" \
        "$HERE/deploy_package.ps1" "$HOST:C:/dev/vf-pkg/" || exit 1
    copy_to "$HERE"/jobs/*.ps1 "$REPO/scripts/bench.ps1" "$REPO/scripts/bench_pack.ps1" "$REPO/scripts/ab_loop_task.ps1" "$HOST:C:/dev/vf-pkg/scripts/" || exit 1
    case "${VFJOB_RUNNER_SHA256:-}" in
        "") ;;
        *[!0-9a-fA-F]*) echo "VFJOB_RUNNER_SHA256 no es un SHA-256 hexadecimal"; exit 1 ;;
        *) [ "${#VFJOB_RUNNER_SHA256}" -eq 64 ] || { echo "VFJOB_RUNNER_SHA256 no tiene 64 caracteres"; exit 1; } ;;
    esac
    # The exit status is the installer's, not grep's: a failed install must not look like success.
    out="$(remote "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\dev\\vf-pkg\\deploy_package.ps1 -Repo $LAPTOP_REPO${VFJOB_RUNNER_SHA256:+ -RunnerSha256 $VFJOB_RUNNER_SHA256}" 2>&1)"; rc=$?
    printf '%s\n' "$out" | LC_ALL=C tr -d '\r' | LC_ALL=C grep -v '^<\|CLIXML\|^$'
    exit $rc
    ;;
sync)
    tmp="$(mktemp -d)"
    git -C "$REPO" bundle create "$tmp/vf.bundle" "${VFJOB_BASE:-main}..HEAD" >/dev/null 2>&1 || { echo "no se pudo crear el bundle"; rm -rf "$tmp"; exit 1; }
    copy_to "$tmp/vf.bundle" "$HOST:C:/dev/vf.bundle" || { rm -rf "$tmp"; exit 1; }
    rm -rf "$tmp"
    want="$(git -C "$REPO" rev-parse --abbrev-ref HEAD)"
    have="$(remote "cd /d $LAPTOP_REPO && git branch --show-current" | tr -d '\r')"
    [ "$have" = "$want" ] || { echo "el laptop esta en la rama '$have' y la Mac en '$want'; no se sincroniza"; exit 1; }
    remote "cd /d $LAPTOP_REPO && git fetch C:\\dev\\vf.bundle HEAD && git merge --ff-only FETCH_HEAD && git log --oneline -1" | LC_ALL=C tr -d '\r'
    ;;
build-test)
    require_idle
    # The log is redirected by cmd (process level): redirecting inside PowerShell turns cargo's stderr into a
    # terminating error because build.ps1 sets $ErrorActionPreference = "Stop".
    script="\$env:Path = '$MINGW;' + \$env:Path; Set-Location '$LAPTOP_REPO'; cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build\\build.ps1 -RunTests > \$env:TEMP\\vf-build-test.log 2>&1\"; 'exit=' + \$LASTEXITCODE; Select-String 'FAILED|PASSED|error' \$env:TEMP\\vf-build-test.log | Select-Object -Last 6 | ForEach-Object { \$_.Line }"
    enc="$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 | LC_ALL=C tr -d '\n')"
    out="$(remote "powershell -NoProfile -EncodedCommand $enc" 2>&1 | LC_ALL=C tr -d '\r' | grep -v '^<\|CLIXML\|^$')"
    printf '%s\n' "$out"
    printf '%s' "$out" | grep -q 'exit=0' && ! printf '%s' "$out" | grep -qE '[1-9][0-9]* FAILED'
    ;;
cross-test)
    # Build on the Mac, copy only the executables and the data files the suite reads, and just run them on the laptop.
    require_idle
    "$REPO/scripts/build/build-cross.sh" || exit 1
    RUN_DIR="${VFJOB_RUN_DIR:-C:\\dev\\vf-run}"
    COPYFILE_DISABLE=1 tar -C "$REPO" -czf - build/vegaflow_tests.exe build/vegaflow_daemon.exe config tests/vectors assets 2>/dev/null |
        remote "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force $RUN_DIR | Out-Null; tar -xzf - -C $RUN_DIR\"" 2>&1 | grep -v 'CLIXML' | head -3
    out="$(remote "cd /d $RUN_DIR && build\\vegaflow_tests.exe" 2>&1 | LC_ALL=C tr -d '\r')"
    printf '%s\n' "$out" | grep -E 'FAIL|TEST RESULTS'
    printf '%s' "$out" | grep -qE 'TEST RESULTS: [0-9]+ PASSED, 0 FAILED'
    ;;
first-start)
    # Stages a daemon (build/vegaflow_daemon.exe unless one is given) in an administrators-only folder and runs the
    # first-start job: no journal, hidden console (or MODE=task, the installer's autostart task), stop event in bounded time.
    require_idle
    exe="${2:-$REPO/build/vegaflow_daemon.exe}"
    [ -f "$exe" ] || { echo "no existe el daemon: $exe (scripts/build/build-cross.sh lo compila)"; exit 1; }
    remote 'if not exist C:\ProgramData\VegaFlow\firststart\stage mkdir C:\ProgramData\VegaFlow\firststart\stage' || exit 1
    copy_to "$exe" "$HOST:C:/ProgramData/VegaFlow/firststart/stage/vegaflow_daemon.exe" || exit 1
    exec "$WB" jobs run first-start "ExeSha256=$(shasum -a 256 "$exe" | cut -c1-64)" "Mode=${MODE:-hidden}" \
        "Arg=${ARG:-none}" "Stdin=${STDIN:-console}" "Journal=${JOURNAL:-none}" "Answer=${ANSWER:-none}"
    ;;
package-test)
    # The zip and the script go to an administrators-only folder: the job runs elevated and checks both SHA-256 before running.
    require_idle
    zip="${2:-${VFJOB_PKG_ZIP:-}}"
    if [ -z "$zip" ]; then
        "$REPO/scripts/build/package.sh" >/dev/null || exit 1
        zip="$(ls -t "$REPO"/dist/VegaFlow-*-win-x64.zip | head -n1)"
    fi
    [ -f "$zip" ] || { echo "no existe el zip: $zip"; exit 1; }
    script="$REPO/tests/package/package_tests.ps1"
    remote 'if not exist C:\ProgramData\VegaFlow\pkgtest mkdir C:\ProgramData\VegaFlow\pkgtest' || exit 1
    copy_to "$zip" "$HOST:C:/ProgramData/VegaFlow/pkgtest/package.zip" && copy_to "$script" "$HOST:C:/ProgramData/VegaFlow/pkgtest/package_tests.ps1" || exit 1
    out="$("$WB" jobs run package-test "ZipSha256=$(shasum -a 256 "$zip" | cut -c1-64)" "ScriptSha256=$(shasum -a 256 "$script" | cut -c1-64)" 2>&1 | LC_ALL=C tr -d '\r')"
    printf '%s\n' "$out"
    file="$(printf '%s\n' "$out" | sed -n 's/^salida=//p' | tail -n1 | tr '\\' '/')"
    if [ -n "$file" ]; then
        dest="${VFJOB_PKG_OUT:-$REPO/build/package-test}"; mkdir -p "$dest"
        scp -q -i "$KEY" -o BatchMode=yes "$HOST:$file" "$dest/" && echo "guardado en $dest/$(basename "$file")"
    fi
    printf '%s\n' "$out" | grep -q '^exit=0' && printf '%s\n' "$out" | grep -qE 'PACKAGE TESTS: [0-9]+ PASSED, 0 FAILED'
    ;;
octo)
    # Long job (one game launch per condition, ~6 min each): wait up to 4 h, then fetch the verification screenshots.
    require_idle
    shift
    prefix="$(printf '%s\n' "$@" | sed -n 's/^Prefix=//p' | tail -n1)"
    "$WB" jobs run -timeout 14400 octo "$@"; rc=$?
    if [ -n "$prefix" ]; then
        dest="${VFJOB_OCTO_OUT:-$REPO/build/octo}"; mkdir -p "$dest"
        scp -q -i "$KEY" -o BatchMode=yes "$HOST:C:/ProgramData/VegaFlow/screens/${prefix}-b*.png" "$dest/" && echo "capturas en $dest"
    fi
    exit $rc
    ;;
*)
    sed -n "2,21p" "$0"
    exit 1
    ;;
esac
