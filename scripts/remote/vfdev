#!/bin/bash
# vfdev: VegaFlow development tools for the test laptop, from the Mac.
# Jobs run in the WinBridge runner (vegaflow package); sync, build-test and deploy use SSH.
#
# Usage:
#   vfdev run JOB [Key=value ...]   launches a job and waits for its result (winbridge jobs run)
#   vfdev submit|wait|status|cancel|busy|list ...   passed as-is to `winbridge jobs`
#   vfdev deploy                      installs the vegaflow package, the tasks and the compiled daemon (administrator over SSH, no UAC)
#   vfdev sync                        brings the current branch's commits to the repository on the laptop (bundle + fast-forward)
#   vfdev build-test                  builds and runs the tests on the laptop; exits with an error if any fails
#   vfdev cross-test                  builds on the Mac (scripts/build-cross.sh), sends only the .exe files and their data to the laptop and just runs the tests there
#   vfdev stats FILE|- [PREFIX]       groups result rows by condition: n, mean, median and range
#   vfdev fetch PREFIX [DEST]         fetches from the laptop the JSON and frame CSVs of captures whose label starts with PREFIX
#   vfdev frames GLOB_A GLOB_B        compares two conditions using the frame CSVs: grouped frames and confidence interval
#   vfdev regress BASE.json GLOB      regression gate: compares new captures with a scene's baseline (baselines/); --make creates it
# Variables: VFJOB_HOST (user@ip), VFJOB_KEY (SSH key), WINBRIDGE_BIN (winbridge client, `winbridge` by default),
#   VFJOB_REPO (repository on the laptop), VFJOB_MINGW (g++ bin folder), VFJOB_BASE (bundle base branch, main),
#   VFJOB_QUEUE=1 (build-test even if jobs are running)
set -u

HOST="${VFJOB_HOST:-testuser@192.0.2.10}"
KEY="${VFJOB_KEY:-$HOME/.ssh/id_ed25519_test}"
WB="${WINBRIDGE_BIN:-winbridge}"
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
HERE="$REPO/scripts/remote"
LAPTOP_REPO="${VFJOB_REPO:-C:\\Users\\testuser\\OneDrive\\Escritorio\\proyectos\\direct}"
MINGW="${VFJOB_MINGW:-C:\\Users\\testuser\\scoop\\apps\\mingw\\16.2.0-rt_v14-rev1\\bin}"

# Runs a command on the laptop over SSH without interaction.
remote() { ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"; }
# Copies files to the laptop with scp without interaction.
copy_to() { scp -q -i "$KEY" -o BatchMode=yes "$@"; }

# Refuses to run while a job is running or queued on the laptop (VFJOB_QUEUE=1 skips the check).
require_idle() {
    [ "${VFJOB_QUEUE:-0}" = 1 ] && return 0
    local busy
    busy="$("$WB" jobs busy 2>&1)"
    case "$busy" in
    *"no job is queued or running"*) ;;
    *) echo "hay trabajos en curso o en cola ($busy); espera o usa VFJOB_QUEUE=1"; exit 3 ;;
    esac
}

case "${1:-}" in
run | submit | wait | status | cancel | busy | list)
    exec "$WB" jobs "$@"
    ;;
stats)
    shift
    exec python3 -I "$HERE/vfstats.py" "$@"
    ;;
fetch)
    [ -n "${2:-}" ] || { sed -n '2,17p' "$0"; exit 1; }
    mkdir -p "${3:-.}"
    exec scp -q -i "$KEY" -o BatchMode=yes "$HOST:C:/ProgramData/WinBridgeJobs/bench/results/${2}*" "${3:-.}/"
    ;;
frames)
    shift
    exec python3 -I "$HERE/vfframes.py" "$@"
    ;;
regress)
    shift
    exec python3 -I "$HERE/vfregress.py" "$@"
    ;;
deploy)
    remote 'if not exist C:\dev\vf-pkg\scripts mkdir C:\dev\vf-pkg\scripts' || exit 1
    copy_to "$HERE/winbridge-package/manifest.json" "$HERE/busy.html" "$REPO/scripts/tweaks_state.ps1" "$REPO/scripts/ab_profile.ps1" \
        "$HERE/deploy_package.ps1" "testuser@${HOST#*@}:C:/dev/vf-pkg/" || exit 1
    copy_to "$HERE"/jobs/*.ps1 "$REPO/scripts/bench.ps1" "$REPO/scripts/bench_pack.ps1" "$REPO/scripts/ab_loop_task.ps1" "testuser@${HOST#*@}:C:/dev/vf-pkg/scripts/" || exit 1
    remote "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\dev\\vf-pkg\\deploy_package.ps1" 2>&1 | LC_ALL=C tr -d '\r' | grep -v '^<\|CLIXML\|^$'
    ;;
sync)
    tmp="$(mktemp -d)"
    git -C "$REPO" bundle create "$tmp/vf.bundle" "${VFJOB_BASE:-main}..HEAD" >/dev/null 2>&1 || { echo "no se pudo crear el bundle"; rm -rf "$tmp"; exit 1; }
    copy_to "$tmp/vf.bundle" "testuser@${HOST#*@}:C:/dev/vf.bundle" || { rm -rf "$tmp"; exit 1; }
    rm -rf "$tmp"
    want="$(git -C "$REPO" rev-parse --abbrev-ref HEAD)"
    have="$(remote "cd /d $LAPTOP_REPO && git branch --show-current" | tr -d '\r')"
    [ "$have" = "$want" ] || { echo "el laptop esta en la rama '$have' y la Mac en '$want'; no se sincroniza"; exit 1; }
    remote "cd /d $LAPTOP_REPO && git fetch C:\\dev\\vf.bundle HEAD && git merge --ff-only FETCH_HEAD && git log --oneline -1" | LC_ALL=C tr -d '\r'
    ;;
build-test)
    require_idle
    # The log is redirected by cmd (process level): redirecting inside PowerShell turns cargo's stderr into a
    # terminating error because build.ps1 sets $ErrorActionPreference = "Stop".
    script="\$env:Path = '$MINGW;' + \$env:Path; Set-Location '$LAPTOP_REPO'; cmd /c \"powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build.ps1 -RunTests > \$env:TEMP\\vf-build-test.log 2>&1\"; 'exit=' + \$LASTEXITCODE; Select-String 'FAILED|PASSED|error' \$env:TEMP\\vf-build-test.log | Select-Object -Last 6 | ForEach-Object { \$_.Line }"
    enc="$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 | LC_ALL=C tr -d '\n')"
    out="$(remote "powershell -NoProfile -EncodedCommand $enc" 2>&1 | LC_ALL=C tr -d '\r' | grep -v '^<\|CLIXML\|^$')"
    printf '%s\n' "$out"
    printf '%s' "$out" | grep -q 'exit=0' && ! printf '%s' "$out" | grep -qE '[1-9][0-9]* FAILED'
    ;;
cross-test)
    # Build on the Mac, copy only the executables and the data files the suite reads, and just run them on the laptop.
    require_idle
    "$REPO/scripts/build-cross.sh" || exit 1
    RUN_DIR="${VFJOB_RUN_DIR:-C:\\dev\\vf-run}"
    COPYFILE_DISABLE=1 tar -C "$REPO" -czf - build/vegaflow_tests.exe build/vegaflow_daemon.exe config tests/vectors assets 2>/dev/null |
        remote "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force $RUN_DIR | Out-Null; tar -xzf - -C $RUN_DIR\"" 2>&1 | grep -v 'CLIXML' | head -3
    out="$(remote "cd /d $RUN_DIR && build\\vegaflow_tests.exe" 2>&1 | LC_ALL=C tr -d '\r')"
    printf '%s\n' "$out" | grep -E 'FAIL|TEST RESULTS'
    printf '%s' "$out" | grep -qE 'TEST RESULTS: [0-9]+ PASSED, 0 FAILED'
    ;;
*)
    sed -n "2,17p" "$0"
    exit 1
    ;;
esac
