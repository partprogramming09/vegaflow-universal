# Settings of the Windows test laptop for scripts/remote/vfdev. Copy this file to scripts/remote/.env (not versioned)
# and fill in your own values; every value below is a placeholder.
VFJOB_HOST=testuser@192.0.2.10
VFJOB_KEY=$HOME/.ssh/id_ed25519_vegaflow_test
VFJOB_REPO='C:\Users\testuser\projects\vegaflow'
VFJOB_MINGW='C:\Users\testuser\scoop\apps\mingw\current\bin'
# Optional: WINBRIDGE_BIN (winbridge client), VFJOB_RUN_DIR (where cross-test copies the executables).
