{
  "env": { "PRESENTMON_EXE": "C:\\ProgramData\\VegaFlow\\tools\\PresentMon.exe" },
  "jobs": {
    "state":        { "script": "state.ps1",         "timeout_s": 60,   "session": 1, "description": "Read-only report of the VegaFlow tweaks against factory values", "params": {} },
    "doctor":       { "script": "doctor.ps1",        "timeout_s": 90,   "session": 1, "description": "Health check of the VegaFlow test setup", "params": {} },
    "restore":      { "script": "restore.ps1",       "timeout_s": 180,  "session": 1, "description": "Put the tweaks back to factory values", "params": {} },
    "daemon-start": { "script": "daemon_start.ps1",  "timeout_s": 90,   "session": 1, "description": "Start the VegaFlow daemon (task VegaFlow-Start)", "params": {} },
    "daemon-stop":  { "script": "daemon_stop.ps1",   "timeout_s": 90,   "session": 1, "description": "Stop the VegaFlow daemon cleanly (task VegaFlow-Stop)", "params": {} },
    "game":         { "script": "game.ps1",          "timeout_s": 90,   "session": 1, "description": "Open the drawstress test program",
                      "params": { "Api": "^(d3d11|d3d12)$", "Dim": "^[0-9]{1,3}$" } },
    "kill-game":    { "script": "kill_game.ps1",     "timeout_s": 30,   "session": 1, "description": "Close the drawstress test program", "params": {} },
    "bench":        { "script": "bench.ps1",         "timeout_s": 600,  "session": 1, "description": "Measure one process with PresentMon",
                      "params": { "Process": "^[A-Za-z0-9_.-]{1,60}\\.exe$", "Label": "^[A-Za-z0-9_.-]{1,60}$", "Seconds": "^[0-9]{1,3}$", "WarmupSeconds": "^[0-9]{1,2}$" } },
    "ab":           { "script": "ab_loop_task.ps1",  "timeout_s": 3600, "session": 1, "description": "A/B loop with and without the daemon",
                      "params": { "Api": "^(d3d11|d3d12)$", "Reps": "^[0-9]{1,2}$", "Seconds": "^[0-9]{1,3}$", "LabelPrefix": "^[A-Za-z0-9_.-]{1,30}$", "Load": "^(none|chrome)$", "LoadWorkers": "^[0-9]{1,2}$", "Sensors": "^(0|1)$", "Process": "^[A-Za-z0-9_.-]{1,60}\\.exe$", "Warmup": "^(0|1)$" } },
    "bg-factors":   { "script": "bg_factors.ps1",    "timeout_s": 3600, "session": 1, "description": "Background-load factors experiment",
                      "params": { "Reps": "^[1-6]$", "Seconds": "^[0-9]{2,3}$", "Workers": "^[0-9]{1,2}$", "Api": "^(d3d11|d3d12)$", "Duty": "^[0-9]{1,3}$", "Kind": "^(cpu|mem)$", "Mode": "^(factors|threads|confine|sim|narrow)$", "Topo": "^(4c|4t2c|6c|4c8t)$", "Diag": "^(0|1)$" } }
  }
}
