{
  "apps": {
    "octopath2": {
      "path": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Octopath_Traveler2\\Octopath_Traveler2\\Binaries\\Win64\\Octopath_Traveler2-Win64-Shipping.exe",
      "window_title": "OCTOPATH TRAVELER II",
      "run_as": "user",
      "description": "Octopath Traveler II (Steam, D3D11): the real-game scene of the regression gate"
    }
  },
  "env": {
    "PRESENTMON_EXE": "C:\\ProgramData\\VegaFlow\\tools\\PresentMon.exe"
  },
  "jobs": {
    "state": {
      "script": "state.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Read-only report of the VegaFlow tweaks against factory values",
      "params": {}
    },
    "doctor": {
      "script": "doctor.ps1",
      "timeout_s": 90,
      "session": 1,
      "description": "Health check of the VegaFlow test setup",
      "params": {}
    },
    "restore": {
      "script": "restore.ps1",
      "timeout_s": 180,
      "session": 1,
      "description": "Put the tweaks back to factory values",
      "params": {}
    },
    "daemon-start": {
      "script": "daemon_start.ps1",
      "timeout_s": 90,
      "session": 1,
      "description": "Start the VegaFlow daemon (task VegaFlow-Start)",
      "params": {}
    },
    "daemon-stop": {
      "script": "daemon_stop.ps1",
      "timeout_s": 90,
      "session": 1,
      "description": "Stop the VegaFlow daemon cleanly (task VegaFlow-Stop)",
      "params": {}
    },
    "game": {
      "script": "game.ps1",
      "timeout_s": 90,
      "session": 1,
      "description": "Open the drawstress test program",
      "params": {
        "Api": "^(d3d11|d3d12)$",
        "Dim": "^[0-9]{1,3}$"
      }
    },
    "kill-game": {
      "script": "kill_game.ps1",
      "timeout_s": 30,
      "session": 1,
      "description": "Close the drawstress test program",
      "params": {}
    },
    "bench": {
      "script": "bench.ps1",
      "timeout_s": 600,
      "session": 1,
      "description": "Measure one process with PresentMon",
      "params": {
        "Process": "^[A-Za-z0-9_.-]{1,60}\\.exe$",
        "Label": "^[A-Za-z0-9_.-]{1,60}$",
        "Seconds": "^[0-9]{1,3}$",
        "WarmupSeconds": "^[0-9]{1,2}$"
      }
    },
    "ab": {
      "script": "ab_loop_task.ps1",
      "timeout_s": 3600,
      "session": 1,
      "description": "A/B loop with and without the daemon",
      "params": {
        "Api": "^(d3d11|d3d12)$",
        "Reps": "^[0-9]{1,2}$",
        "Seconds": "^[0-9]{1,3}$",
        "LabelPrefix": "^[A-Za-z0-9_.-]{1,30}$",
        "Load": "^(none|chrome|mix)$",
        "LoadWorkers": "^[0-9]{1,2}$",
        "Sensors": "^(0|1)$",
        "Process": "^[A-Za-z0-9_.-]{1,60}\\.exe$",
        "Warmup": "^(0|1)$"
      }
    },
    "bg-factors": {
      "script": "bg_factors.ps1",
      "timeout_s": 3600,
      "session": 1,
      "description": "Background-load factors experiment",
      "params": {
        "Reps": "^[1-6]$",
        "Seconds": "^[0-9]{2,3}$",
        "Workers": "^[0-9]{1,2}$",
        "Api": "^(d3d11|d3d12)$",
        "Duty": "^[0-9]{1,3}$",
        "Kind": "^(cpu|mem)$",
        "Mode": "^(factors|threads|confine|sim|narrow)$",
        "Topo": "^(4c|4t2c|6c|4c8t)$",
        "Diag": "^(0|1)$"
      }
    },
    "pack": {
      "script": "bench_pack.ps1",
      "timeout_s": 1800,
      "session": 1,
      "description": "Measure one scene with the test-plan protocol and zip results with the machine fingerprint",
      "params": {
        "Process": "^[A-Za-z0-9_.-]{1,60}\\.exe$",
        "Label": "^[A-Za-z0-9_.-]{1,60}$",
        "Captures": "^[0-9]{1}$",
        "Seconds": "^[0-9]{1,3}$"
      }
    },
    "screenshot": {
      "script": "screenshot.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Save a PNG screenshot of the desktop session and report if it is black",
      "params": {
        "Name": "^[A-Za-z0-9_.-]{1,40}$"
      }
    },
    "gui": {
      "script": "gui.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Open the GUI of the test build (--gui; needs an elevated session)",
      "params": {}
    },
    "package-test": {
      "script": "package_test.ps1",
      "timeout_s": 600,
      "session": 1,
      "description": "Run tests/package/package_tests.ps1 on a package zip staged by vfdev package-test; keeps the whole output in a dated file",
      "params": {
        "ZipSha256": "^[0-9a-fA-F]{64}$",
        "ScriptSha256": "^[0-9a-fA-F]{64}$"
      }
    },
    "first-start": {
      "script": "first_start.ps1",
      "timeout_s": 240,
      "session": 1,
      "description": "First unattended start of a daemon staged by vfdev first-start, with no journal: does it reach Global\\VegaFlowStop in bounded time",
      "params": {
        "ExeSha256": "^[0-9a-fA-F]{64}$",
        "Mode": "^(hidden|task|wt)$",
        "Arg": "^(none|once|dry-run)$",
        "Stdin": "^(console|file|pipe)$",
        "Journal": "^(none|unclean|corrupt)$",
        "Answer": "^(none|n)$"
      }
    },
    "octo": {
      "script": "octo.ps1",
      "timeout_s": 14400,
      "session": 1,
      "description": "Open Octopath Traveler II through Steam, load the autosave, check the scene by screenshot and FPS, and measure one block per launch with an Engine.ini variant (daemon off)",
      "params": {
        "Conditions": "^(factory|streaming|visual|async|full|keep)(,(factory|streaming|visual|async|full|keep)){0,19}$",
        "Prefix": "^[a-z0-9]{1,20}$",
        "Captures": "^[0-5]$",
        "Seconds": "^[0-9]{2,3}$",
        "Warmup": "^(0|1)$",
        "Leave": "^(0|1)$"
      }
    },
    "octo-close": {
      "script": "octo_close.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Close Octopath Traveler II with Stop-Process and put back the Engine.ini the octo job saved",
      "params": {}
    },
    "kill-gui": {
      "script": "kill_gui.ps1",
      "timeout_s": 30,
      "session": 1,
      "description": "Close the test-build GUI (never the installed daemon)",
      "params": {}
    },
    "gui-keys": {
      "script": "gui_keys.ps1",
      "timeout_s": 30,
      "session": 1,
      "description": "Send Tab/Enter/Esc/Space/arrow keys to the test-build GUI, only while it is the foreground window",
      "params": {
        "Keys": "^(\\{(TAB|ENTER|ESC|SPACE|LEFT|RIGHT|UP|DOWN)\\}|\\+\\{TAB\\}|\\^[1-8]|[0-9,])+$"
      }
    },
    "gui-second": {
      "script": "gui_second.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Start a second test-build GUI while the first is open and report whether the first is brought forward",
      "params": {}
    },
    "dpi": {
      "script": "dpi.ps1",
      "timeout_s": 60,
      "session": 1,
      "description": "Set the Windows display scale of the primary monitor (100/125/150/175/200) or put the saved original back",
      "params": {
        "Percent": "^(100|125|150|175|200|original)$"
      }
    },
    "clip": {
      "script": "clip.ps1",
      "timeout_s": 30,
      "session": 1,
      "description": "Show the clipboard only if it holds the VegaFlow report (else just its length)",
      "params": {}
    }
  }
}
